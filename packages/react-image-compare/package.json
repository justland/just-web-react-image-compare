{
	"name": "@just-web/react-image-compare",
	"version": "0.1.0",
	"description": "React component that compares two images side by side, with a swipe divider, or as an onion skin",
	"keywords": [
		"react",
		"image",
		"compare",
		"image-compare",
		"image-diff",
		"diff",
		"swipe",
		"onion-skin",
		"side-by-side",
		"visual-testing"
	],
	"homepage": "https://github.com/justland/just-web-react-image-compare",
	"bugs": {
		"url": "https://github.com/justland/just-web-react-image-compare/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/justland/just-web-react-image-compare.git",
		"directory": "packages/react-image-compare"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com",
		"url": "https://github.com/unional"
	},
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#just-web/react-image-compare": "./src/index.ts"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"files": [
		"dist",
		"src",
		"!**/*.{spec,unit,test,accept,integrate,system,pref,stress}.*",
		"!**/*.stories.*",
		"!**/*.mdx",
		"!src/testing"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "rimraf dist cjs esm coverage lib --glob *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"nuke": "rimraf node_modules",
		"sb": "storybook dev -p 6016",
		"sb:build": "storybook build",
		"size": "size-limit",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"v": "npm-run-all -p build lint coverage depcheck -p size",
		"w": "run-p w:build w:test",
		"w:build": "tsc -w",
		"w:test": "vitest"
	},
	"devDependencies": {
		"@repobuddy/storybook": "^2.3.0",
		"@repobuddy/typescript": "^2.1.0",
		"@repobuddy/vitest": "^2.1.2",
		"@size-limit/preset-small-lib": "^12.0.0",
		"@storybook/addon-a11y": "^10.5.10",
		"@storybook/addon-docs": "^10.5.10",
		"@storybook/addon-vitest": "^10.5.10",
		"@storybook/react-vite": "^10.5.10",
		"@tailwindcss/vite": "^4.3.3",
		"@vitest/browser": "^4.1.11",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"npm-run-all2": "^8.0.0",
		"playwright": "^1.62.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"rimraf": "^6.1.3",
		"size-limit": "^13.0.3",
		"storybook": "^10.5.10",
		"storybook-addon-tag-badges": "^3.1.0",
		"tailwindcss": "^4.3.3",
		"tsdown": "^0.22.14",
		"typescript": "^5.9.3",
		"vite": "^7.3.5",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	}
}
