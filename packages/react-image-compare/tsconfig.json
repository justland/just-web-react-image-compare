{
	"extends": "@repobuddy/typescript/tsconfig/monorepo.json",
	"compilerOptions": {
		// Classic runtime (React.createElement): the Storybook manager shares only react, react-dom and react-dom/client with addons, not react/jsx-runtime.
		"jsx": "react",
		"module": "preserve",
		"moduleResolution": "bundler",
		"outDir": ".nowhere",
		"rewriteRelativeImportExtensions": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"types": ["vite/client"]
	},
	"include": ["src/**/*", "*.config.ts"]
}
