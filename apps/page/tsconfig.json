{
	"extends": "@repobuddy/typescript/tsconfig/monorepo.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"module": "preserve",
		"moduleResolution": "bundler",
		"outDir": ".nowhere",
		"rewriteRelativeImportExtensions": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true
	},
	"include": [".storybook/**/*.ts"]
}
